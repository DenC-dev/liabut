begin mrbayes;
  set autoclose=yes nowarn=yes seed=1234 swapseed=1235;
  execute matrix.nex;
  outgroup lama1277_lewoi;
  lset coding=noabsencesites rates=gamma;
  prset brlenspr=unconstrained:exp(10.0);
  mcmcp ngen=2000000 samplefreq=1000 diagnfreq=50000 nruns=2 nchains=2 printfreq=100000 filename=unconstrained;
  mcmc;
  sumt filename=unconstrained burnin=1000 contype=allcompat;
  sump filename=unconstrained burnin=1000;
end;
